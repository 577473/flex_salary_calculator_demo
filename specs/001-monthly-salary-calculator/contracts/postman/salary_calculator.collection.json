{
  "info": {
    "name": "Flex Salary Calculator API",
    "_postman_id": "0a6f857d-8c2e-4a1e-9d3a-5f2c7b1e9c40",
    "description": "REST API for the flexible monthly salary calculator demo. Import this collection, ensure the `baseUrl` variable points to the running Rails server (default http://localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "period",
      "value": "2026-09"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Liveness check."
      }
    },
    {
      "name": "List Employees",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/employees",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "employees"]
        },
        "description": "List all employees."
      }
    },
    {
      "name": "Get Employee",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/employees/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "employees", "1"]
        },
        "description": "Get one employee with job history."
      }
    },
    {
      "name": "Calculate Payroll",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employee_ids\": [1, 2, 3, 4],\n  \"period\": \"{{period}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/liquidaciones/calculate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "liquidaciones", "calculate"]
        },
        "description": "Calculate and persist Liquidaciones for the given employees and period. Per-employee failures are reported in the envelope."
      }
    },
    {
      "name": "List Liquidaciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/liquidaciones?period={{period}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "liquidaciones"],
          "query": [
            {
              "key": "period",
              "value": "{{period}}"
            }
          ]
        },
        "description": "List Liquidaciones for a period."
      }
    },
    {
      "name": "Get Liquidacion",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/liquidaciones/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "liquidaciones", "1"]
        },
        "description": "Get a Liquidacion with its per-item audit breakdown."
      }
    }
  ]
}